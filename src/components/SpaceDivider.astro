---
// section divider: a rocket, comet or satellite at the end of a random trail
interface Props {
  kind: 'rocket' | 'comet' | 'satellite';
  seed: number;
  flip?: boolean;
}

const { kind, seed, flip = false } = Astro.props;
const uid = `${kind}-${seed}`;
// viewBox matches the text column; the trail starts far off the left edge
const W = 1120;
const H = 160;

// seeded random so the same divider looks the same on every build
let s = seed * 9973 + kind.length * 131;
const rand = () => {
  s |= 0; s = (s + 0x6d2b79f5) | 0;
  let t = Math.imul(s ^ (s >>> 15), 1 | s);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const R = (a: number, b: number) => a + rand() * (b - a);
const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
type Pt = [number, number];

// waypoints from off-screen to the craft
const amp = { rocket: 42, comet: 26, satellite: 18 }[kind];
const reach = { rocket: [950, 1010], satellite: [1000, 1050], comet: [1020, 1070] }[kind];
const end: Pt = [R(reach[0], reach[1]), R(44, 116)];
const START = -800;
const startY = R(30, 130);
const n = 4 + Math.floor(rand() * 3);
let pts: Pt[] = [];
for (let i = 0; i <= n; i++) {
  const f = i / n;
  const x = START + f * (end[0] - START) + (i > 0 && i < n ? R(-50, 50) : 0);
  const y = i === 0 ? startY : i === n ? end[1] : clamp(startY + (end[1] - startY) * f + R(-amp, amp), 30, 130);
  pts.push([x, y]);
}

// smooth curve through the waypoints (Catmull-Rom as cubic Béziers)
const segs: [Pt, Pt, Pt, Pt][] = [];
for (let i = 0; i < pts.length - 1; i++) {
  const p0 = pts[i - 1] ?? pts[i], p1 = pts[i], p2 = pts[i + 1], p3 = pts[i + 2] ?? p2;
  const c1: Pt = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
  const c2: Pt = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
  segs.push([p1, c1, c2, p2]);
}
const f1 = (v: number) => v.toFixed(1);
const d = `M${f1(pts[0][0])} ${f1(pts[0][1])}` + segs.map(([, c1, c2, p]) => ` C${f1(c1[0])} ${f1(c1[1])} ${f1(c2[0])} ${f1(c2[1])} ${f1(p[0])} ${f1(p[1])}`).join('');
const last = segs[segs.length - 1];
const angle = (Math.atan2(last[3][1] - last[2][1], last[3][0] - last[2][0]) * 180) / Math.PI;

// sample the curve so things can be placed along it by distance
const bez = ([a, b, c, e]: [Pt, Pt, Pt, Pt], t: number): Pt => {
  const u = 1 - t;
  return [0, 1].map((i) => u * u * u * a[i] + 3 * u * u * t * b[i] + 3 * u * t * t * c[i] + t * t * t * e[i]) as Pt;
};
const poly: { p: Pt; dist: number }[] = [];
let total = 0;
for (const seg of segs) {
  for (let i = poly.length ? 1 : 0; i <= 40; i++) {
    const p = bez(seg, i / 40);
    if (poly.length) total += Math.hypot(p[0] - poly[poly.length - 1].p[0], p[1] - poly[poly.length - 1].p[1]);
    poly.push({ p, dist: total });
  }
}
const pointAt = (dist: number): Pt => poly.find((q) => q.dist >= dist)?.p ?? poly[poly.length - 1].p;

// rocket smoke: dense small puffs near the rocket, bigger and fainter further back
const puffs: { x: number; y: number; r: number; o: number; delay: number }[] = [];
if (kind === 'rocket') {
  let back = 6;
  while (back < total) {
    const f = back / total;
    const [x, y] = pointAt(total - back);
    if (x < -560) break;
    const r = 2.5 + 15 * Math.pow(f, 0.7);
    puffs.push({ x: x + R(-0.3, 0.3) * r, y: y + R(-0.35, 0.35) * r, r: r * R(0.8, 1.15), o: 0.05 + 0.5 * Math.pow(1 - f, 1.4), delay: 1.35 * (1 - f) });
    back += 5 + 13 * f;
  }
}

// comet dust
const dust = kind === 'comet'
  ? Array.from({ length: 7 }, (_, i) => {
      const [x, y] = pointAt(total * (0.55 + i * 0.06));
      return { x: x + R(-6, 6), y: y + R(-8, 8), r: R(0.8, 1.6) };
    })
  : [];

const sparkles = Array.from({ length: 5 }, () => [R(20, W - 20), R(16, H - 16), R(0.55, 1.05)]);
---

<div class:list={['flight', 'wrap', 'reveal', `flight-${kind}`, { flip }]} aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMaxYMid slice">
    <defs>
      <linearGradient id={`trail-${uid}`} gradientUnits="userSpaceOnUse" x1="-160" y1="0" x2={f1(end[0])} y2="0">
        <stop offset="0" style="stop-color: var(--trail); stop-opacity: 0"></stop>
        <stop offset="1" style="stop-color: var(--trail)"></stop>
      </linearGradient>
      <filter id={`soft-${uid}`} x="-10%" y="-60%" width="120%" height="220%">
        <feGaussianBlur stdDeviation="2.6"></feGaussianBlur>
      </filter>
      {kind === 'comet' && (
        <radialGradient id={`glow-${uid}`}>
          <stop offset="0" style="stop-color: var(--comet); stop-opacity: .55"></stop>
          <stop offset="1" style="stop-color: var(--comet); stop-opacity: 0"></stop>
        </radialGradient>
      )}
    </defs>

    {sparkles.map(([x, y, sc], i) => (
      <g transform={`translate(${f1(x)} ${f1(y)}) scale(${sc.toFixed(2)})`}>
        <path class="spark" style={`--d:${(i * 0.7).toFixed(1)}s`} d="M0 -6 L1.4 -1.4 L6 0 L1.4 1.4 L0 6 L-1.4 1.4 L-6 0 L-1.4 -1.4 Z"></path>
      </g>
    ))}

    {kind === 'rocket' && (
      <>
        <g filter={`url(#soft-${uid})`}>
          {puffs.map((p) => (
            <circle class="puff" cx={f1(p.x)} cy={f1(p.y)} r={f1(p.r)} style={`--o:${p.o.toFixed(2)};--delay:${p.delay.toFixed(2)}s`}></circle>
          ))}
        </g>
        <g class="craft">
          <g transform={`translate(${f1(end[0])} ${f1(end[1])}) rotate(${angle.toFixed(1)})`}>
            <g class="bob">
              <path class="flame" d="M2 0 L-18 -6 L-11 0 L-18 6 Z"></path>
              <path class="flame-in" d="M2 0 L-10 -3 L-6 0 L-10 3 Z"></path>
              <path class="fin" d="M10 -9 L-2 -21 L20 -9 Z"></path>
              <path class="fin" d="M10 9 L-2 21 L20 9 Z"></path>
              <path class="hull" d="M2 -9 H48 C60 -9 70 -4 76 0 C70 4 60 9 48 9 H2 Z"></path>
              <circle class="window" cx="45" cy="0" r="5"></circle>
            </g>
          </g>
        </g>
      </>
    )}

    {kind === 'comet' && (
      <>
        <path class="trail tail-glow" d={d} pathLength="1" stroke={`url(#trail-${uid})`} filter={`url(#soft-${uid})`}></path>
        <path class="trail tail" d={d} pathLength="1" stroke={`url(#trail-${uid})`}></path>
        {dust.map((p) => <circle class="dust" cx={f1(p.x)} cy={f1(p.y)} r={f1(p.r)}></circle>)}
        <g class="craft">
          <g transform={`translate(${f1(end[0])} ${f1(end[1])})`}>
            <circle class="comet-glow" r="22" fill={`url(#glow-${uid})`}></circle>
            <circle class="comet-head" r="5"></circle>
          </g>
        </g>
      </>
    )}

    {kind === 'satellite' && (
      <>
        <path class="orbit-line" d={d} stroke={`url(#trail-${uid})`}></path>
        <g class="craft">
          <g transform={`translate(${f1(end[0])} ${f1(end[1])}) rotate(${angle.toFixed(1)})`}>
            <g class="sway">
              <path class="signal" d="M44 -10 A14 14 0 0 1 44 10 M52 -16 A22 22 0 0 1 52 16"></path>
              <rect class="panel" x="-36" y="-6" width="22" height="12" rx="1.5"></rect>
              <rect class="panel" x="14" y="-6" width="22" height="12" rx="1.5"></rect>
              <path class="panel-line" d="M-29 -6 V6 M-21 -6 V6 M21 -6 V6 M29 -6 V6 M-14 0 H-8 M8 0 H14"></path>
              <rect class="hull" x="-8" y="-8" width="16" height="16" rx="3"></rect>
              <path class="antenna" d="M0 -8 V-17"></path>
              <circle class="window" cx="0" cy="-18" r="2.2"></circle>
            </g>
          </g>
        </g>
      </>
    )}
  </svg>
</div>
