---
interface Props {
  current?: string;
}

const { current } = Astro.props;

const links = [
  { key: 'work', label: 'Work' },
  { key: 'research', label: 'Research' },
  { key: 'writing', label: 'Writing' },
  { key: 'about', label: 'About' },
];
---

<header class="nav" id="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/" aria-label="Suphachat Sriharan, home">
      <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="5.5"></circle><ellipse cx="12" cy="12" rx="10.5" ry="3.4" transform="rotate(-18 12 12)"></ellipse></svg>
      <span>Suphachat</span>
    </a>
    <nav class="nav-links" id="nav-links" aria-label="Main">
      {links.map((l) => <a href={`/${l.key}`} aria-current={l.key === current ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <button class="theme-toggle" type="button"><span class="tt-icon" aria-hidden="true"></span><span class="tt-label">Night</span></button>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Menu"><span></span><span></span></button>
  </div>
</header>
