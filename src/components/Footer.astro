---
import { site } from '../data/site';
---

<footer class="footer">
  <div class="wrap footer-inner">
    <p class="footer-copy">© <span data-year>2026</span> {site.name} · Bangkok</p>
    <nav class="footer-links" aria-label="Elsewhere">
      <a href={`mailto:${site.email}`}>Email</a>
      <a href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={site.links.github} target="_blank" rel="noopener">GitHub</a>
      <a href={site.links.medium} target="_blank" rel="noopener">Medium</a>
      <a href={site.cv} download={site.cvFile}>CV</a>
    </nav>
  </div>
</footer>
