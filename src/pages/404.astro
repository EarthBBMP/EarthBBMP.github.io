---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Lost in orbit · Suphachat Sriharan" social={false} footer={false}>
  <section class="lost">
    <p class="eyebrow">Error 404</p>
    <h1 class="page-title">Lost in <span class="script">orbit</span></h1>
    <p class="page-lede">This page drifted off somewhere. The rest of the site is still on the ground.</p>
    <p><a class="btn btn-solid" href="/">Back to Earth <Icon name="arrow" /></a></p>
  </section>
</BaseLayout>
